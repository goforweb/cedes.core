<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:browser="http://namespaces.zope.org/browser"
           xmlns:faceted="http://namespaces.zope.org/faceted"
           xmlns:five="http://namespaces.zope.org/five"
           xmlns:plone="http://namespaces.plone.org/plone">

    <include package="z3c.jbot" file="meta.zcml" />
    <browser:jbot directory="jbot" />

    <!-- Publish static files -->
    <include package="plone.resource" file="meta.zcml"/>
    <plone:static
        name="cedes.core"
        type="plone"
        directory="static" />

    <!-- faceted view for Theme -->
    <faceted:view
      name="faceted-theme-view"
      class="cedes.core.browser.faceted.FacetedThemeView"
      template="templates/faceted-theme-view.pt"
      title="Faceted CeDES Theme view"
      permission="zope2.View" />
    <configure package="eea.facetednavigation">
      <browser:page
        for="cedes.core.interfaces.IThemeFacetedNavigable"
        name="faceted_query"
        class="cedes.core.browser.faceted.ThemeFacetedQueryHandler"
        template="browser/template/query.pt"
        permission="zope2.View" />
    </configure>

    <!-- conent_types default view -->
    <!-- Theme -->
    <browser:page
        for="cedes.core.content.theme.ITheme"
        name="view"
        class="cedes.core.browser.theme.ThemeDefaultView"
        template="templates/theme-view.pt"
        permission="zope2.View" />

    <!-- DossierStructure -->
    <browser:page
        for="cedes.core.content.dossierstructure.IDossierStructure"
        name="view"
        class="cedes.core.browser.dossierstructure.DossierStructureDefaultView"
        template="templates/dossierstructure_view.pt"
        permission="zope2.View" />

    <!-- The view rendering common-result-listing -->
    <browser:page
        for="*"
        class="cedes.core.browser.views.CommonResultListingView"
        name="common-result-listing"
        template="templates/common-result-listing.pt"
        permission="zope2.View"
        allowed_attributes="searchForThemeView" />

    <!-- The view rendering the content displayed in common-result-listing,
         aka common-result-listing-content -->
    <browser:page
        for="*"
        class="cedes.core.browser.views.CommonResultListingView"
        name="common-result-listing-content"
        template="templates/common-result-listing-content.pt"
        permission="zope2.View" />

    <!-- Override sitemap to use it to display plan -->
    <browser:page
        for="*"
        name="sitemap_builder_view"
        class="cedes.core.browser.views.ContextCatalogSiteMap"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="zope.Public"
        allowed_attributes="siteMap" />
    <browser:page
        for="*"
        name="planclassement_view"
        class="cedes.core.browser.views.ContextSitemapView"
        template="templates/contextsitemap.pt"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="zope.Public"
        allowed_interface="Products.CMFPlone.browser.interfaces.ISitemapView" />

    <!-- overrides for @@download of formwidget.namedfile, manage access to ArticlePayant -->
    <browser:page
        name="download"
        for="plone.formwidget.namedfile.interfaces.INamedFileWidget"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        class=".views.ArticlePayantDownload"
        permission="zope2.Public" />

    <!-- overrides the @@listing_view for Folders -->
    <browser:page
        for="plone.dexterity.interfaces.IDexterityContainer"
        name="listing_view"
        class="plone.app.contenttypes.browser.folder.FolderView"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="zope2.View"
        template="templates/folder-listing.pt" />
    <!-- make original @@listing_view available as @@plone_listing_view -->
    <configure package="plone.app.contenttypes.browser">
        <browser:page
            for="plone.dexterity.interfaces.IDexterityContainer"
            name="plone_listing_view"
            class=".folder.FolderView"
            permission="zope2.View"
            template="templates/listing.pt" />
    </configure>

    <!-- The jQuery/ajax content refresh view that refresh common-result-listing-content -->
    <browser:page
        for="*"
        class="cedes.core.browser.views.CommonResultListingView"
        name="get_common_result_listing"
        attribute="update_content"
        permission="zope2.View" />

    <!-- dossierstructure_pdf -->
    <browser:page
        for="*"
        class="cedes.core.browser.dossierstructure.DossierStructurePDF"
        name="dossierstructure_pdf"
        template="templates/dossierstructure_pdf.pt"
        permission="zope2.View" />
    <!-- The view rendering html-toc -->
    <browser:view
        for="*"
        class="cedes.core.browser.dossierstructure.HTMLTocView"
        name="html-toc"
        allowed_attributes="point_title
                            point_number"
        permission="zope2.View" />
    <!-- generate_pdf -->
    <browser:view
        for="cedes.core.content.dossierstructure.IDossierStructure"
        class="cedes.core.browser.dossierstructure.GeneratePDFView"
        name="generate_pdf"
        permission="cmf.ManagePortal" />
    <!-- pdf -->
    <browser:view
        for="cedes.core.content.dossierstructure.IDossierStructure"
        class="cedes.core.browser.dossierstructure.GetPDFView"
        name="pdf"
        permission="zope2.View" />

    <!-- portlets -->
    <browser:page
        for="*"
        class="cedes.core.browser.portlets.PortletRecent"
        name="portlet_recent"
        template="templates/portlet_recent.pt"
        permission="zope2.View" />
    <browser:page
        for="*"
        class="cedes.core.browser.portlets.PortletPlan"
        name="portlet_plan"
        template="templates/portlet_plan.pt"
        permission="zope2.View" />
    <browser:page
        for="*"
        class="cedes.core.browser.portlets.PortletDossiers"
        name="portlet_dossiers"
        template="templates/portlet_folders.pt"
        permission="zope2.View" />
    <browser:page
        for="*"
        class="cedes.core.browser.portlets.PortletCedes"
        name="portlet_cedes"
        template="templates/portlet_folders.pt"
        permission="zope2.View" />

    <!-- Asynchronous calls (ajax) -->
    <browser:page
        name="ds_price"
        class=".async.DSPrice"
        for="*"
        permission="zope2.View" />

    <!-- Members management -->
    <browser:page
        name="member-search"
        for="*"
        class=".membersearch.CeDESMemberSearchForm"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="zope2.View" />
    <browser:page
        name="register"
        for="plone.app.layout.navigation.interfaces.INavigationRoot"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        class=".register.CeDESRegistrationForm"
        permission="cmf.AddPortalMember" />
    <browser:page
        name="registered"
        for="plone.app.layout.navigation.interfaces.INavigationRoot"
        class=".registered.CeDESRegisteredView"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        template="templates/registered.pt"
        permission="cmf.AddPortalMember" />

</configure>
