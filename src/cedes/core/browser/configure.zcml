<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:browser="http://namespaces.zope.org/browser"
           xmlns:faceted="http://namespaces.zope.org/faceted"
           xmlns:five="http://namespaces.zope.org/five"
           xmlns:plone="http://namespaces.plone.org/plone"
           xmlns:z3c="http://namespaces.zope.org/z3c">

    <include package="z3c.jbot" file="meta.zcml" />
    <browser:jbot directory="jbot" />

    <!-- Publish static files -->
    <include package="plone.resource" file="meta.zcml"/>
    <plone:static
        name="cedes.core"
        type="plone"
        directory="static" />

    <!-- faceted view for Theme -->
    <faceted:view
      name="faceted-theme-view"
      class="cedes.core.browser.faceted.FacetedThemeView"
      template="templates/faceted_theme_view.pt"
      title="Faceted CeDES Theme view"
      permission="zope2.View" />
    <configure package="eea.facetednavigation">
      <browser:page
        for="cedes.core.interfaces.IThemeFacetedNavigable"
        name="faceted_query"
        class="cedes.core.browser.faceted.ThemeFacetedQueryHandler"
        template="browser/template/query.pt"
        permission="zope2.View" />
    </configure>

    <!-- Move contentleadimage viewlet under the descripiton -->
    <configure package="plone.app.contenttypes.behaviors">
        <browser:viewlet
          name="contentleadimage"
          for=".leadimage.ILeadImage"
          view="plone.app.layout.globals.interfaces.IViewView"
          class=".viewlets.LeadImageViewlet"
          manager="plone.app.layout.viewlets.interfaces.IAboveContentBody"
          layer="cedes.core.interfaces.ICedesCoreLayer"
          template="leadimage.pt"
          permission="zope2.View" />
    </configure>

    <!-- override membertools viewlet -->
    <!-- The member panel (logout, user actions) -->
    <browser:viewlet
        name="plone.membertools"
        manager="plone.app.layout.viewlets.interfaces.IPortalHeader"
        class="plone.app.layout.viewlets.common.PersonalBarViewlet"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="zope2.View"
        template="templates/membertools.pt" />

    <!-- Override the keywords viewlet to show it only to administrators -->
    <configure package="plone.app.layout.viewlets">
        <browser:viewlet
            name="plone.keywords"
            manager=".interfaces.IBelowContentBody"
            view="plone.app.layout.globals.interfaces.IViewView"
            layer="cedes.core.interfaces.ICedesCoreLayer"
            template="keywords.pt"
            permission="cmf.ManagePortal" />
    </configure>

    <!-- Override the site footer -->
    <browser:page
        for="*"
        name="footer"
        permission="zope.Public"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        template="templates/footer.pt" />

    <!-- override contact-info -->
    <browser:page
        for="*"
        name="contact-info"
        class=".overrides.CedesContactForm"
        permission="zope.Public"
        layer="cedes.core.interfaces.ICedesCoreLayer" />

    <!-- content_types default view -->
    <!-- title -->
    <browser:page
        for="cedes.core.content.resource.IResource"
        name="title"
        class=".overrides.TitleView"
        template="templates/title.pt"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="zope.Public" />
    <!-- description -->
    <browser:page
        for="cedes.core.content.resource.IResource"
        name="description"
        template="templates/description.pt"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="zope.Public" />
    <!-- ArticleGratuit -->
    <browser:page
        for="cedes.core.content.articlegratuit.IArticleGratuit"
        name="view"
        class="cedes.core.browser.content.ArticleGratuitView"
        template="templates/articlegratuit_view.pt"
        permission="zope2.View" />
    <!-- ArticlePayant -->
    <browser:page
        for="cedes.core.content.articlepayant.IArticlePayant"
        name="view"
        class="cedes.core.browser.content.ArticlePayantView"
        template="templates/articlepayant_view.pt"
        permission="zope2.View" />
    <!-- Audio -->
    <browser:page
        for="cedes.core.content.audio.IAudio"
        name="view"
        class="cedes.core.browser.content.AudioView"
        template="templates/audio_view.pt"
        permission="zope2.View" />
    <!-- Bibliographie -->
    <browser:page
        for="cedes.core.content.bibliographie.IBibliographie"
        name="view"
        class="cedes.core.browser.content.BibliographieView"
        template="templates/bibliographie_view.pt"
        permission="zope2.View" />
    <!-- DossierStructure -->
    <browser:page
        for="cedes.core.content.dossierstructure.IDossierStructure"
        name="view"
        class="cedes.core.browser.dossierstructure.DossierStructureView"
        template="templates/dossierstructure_view.pt"
        permission="zope2.View" />
    <!-- SiteInternet -->
    <browser:page
        for="cedes.core.content.siteinternet.ISiteInternet"
        name="view"
        class="cedes.core.browser.content.SiteInternetView"
        template="templates/siteinternet_view.pt"
        permission="zope2.View" />
    <!-- SequenceApprentissage -->
    <browser:page
        for="cedes.core.content.sequenceapprentissage.ISequenceApprentissage"
        name="view"
        class="cedes.core.browser.content.SequenceApprentissageView"
        template="templates/sequenceapprentissage_view.pt"
        permission="zope2.View" />
    <!-- Statistiques -->
    <browser:page
        for="cedes.core.content.statistiques.IStatistiques"
        name="view"
        class="cedes.core.browser.content.StatistiquesView"
        template="templates/statistiques_view.pt"
        permission="zope2.View" />
    <!-- Theme -->
    <browser:page
        for="cedes.core.content.theme.ITheme"
        name="view"
        class="cedes.core.browser.theme.ThemeView"
        template="templates/theme_view.pt"
        permission="zope2.View" />
    <!-- Video -->
    <browser:page
        for="cedes.core.content.video.IVideo"
        name="view"
        class="cedes.core.browser.content.VideoView"
        template="templates/video_view.pt"
        permission="zope2.View" />

    <!-- The view rendering common-result-listing -->
    <browser:page
        for="*"
        class="cedes.core.browser.views.CommonResultListingView"
        name="common-result-listing"
        template="templates/common-result-listing.pt"
        permission="zope2.View"
        allowed_attributes="searchForThemeView" />

    <!-- The view rendering the content displayed in common-result-listing,
         aka common-result-listing-content -->
    <browser:page
        for="*"
        class="cedes.core.browser.views.CommonResultListingView"
        name="common-result-listing-content"
        template="templates/common-result-listing-content.pt"
        permission="zope2.View" />

    <!-- Override sitemap to use it to display plan -->
    <browser:page
        for="*"
        name="sitemap_builder_view"
        class="cedes.core.browser.views.ContextCatalogSiteMap"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="zope.Public"
        allowed_attributes="siteMap" />
    <browser:page
        for="*"
        name="planclassement_view"
        class="cedes.core.browser.views.ContextSitemapView"
        template="templates/contextsitemap.pt"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="zope.Public"
        allowed_interface="Products.CMFPlone.browser.interfaces.ISitemapView" />

    <!-- breadcrumbs for resources -->
      <browser:page
        for="cedes.core.content.resource.IResource"
        name="breadcrumbs_view"
        class=".breadcrumbs.ClassificationBreadcrumbs"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="zope.Public"
        allowed_attributes="breadcrumbs" />

    <!-- overrides for @@download of formwidget.namedfile, manage access to ArticlePayant -->
    <browser:page
        name="download"
        for="plone.formwidget.namedfile.interfaces.INamedFileWidget"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        class=".views.ArticlePayantDownload"
        permission="zope2.Public" />

    <!-- overrides the @@listing_view for Folders -->
    <browser:page
        for="plone.dexterity.interfaces.IDexterityContainer"
        name="listing_view"
        class="cedes.core.browser.overrides.CedesFolderView"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="zope2.View"
        template="templates/folder-listing.pt" />
    <!-- make original @@listing_view available as @@plone_listing_view -->
    <configure package="plone.app.contenttypes.browser">
        <browser:page
            for="plone.dexterity.interfaces.IDexterityContainer"
            name="plone_listing_view"
            class=".folder.FolderView"
            permission="zope2.View"
            template="templates/listing.pt" />
    </configure>
    <!-- add the @@listing_full_view for Folders -->
    <browser:page
        for="plone.dexterity.interfaces.IDexterityContainer"
        name="listing_full_view"
        class="cedes.core.browser.overrides.CedesFolderView"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="zope2.View"
        template="templates/folder-listing.pt" />

    <!-- The jQuery/ajax content refresh view that refresh common-result-listing-content -->
    <browser:page
        for="*"
        class="cedes.core.browser.views.CommonResultListingView"
        name="get_common_result_listing"
        attribute="update_content"
        permission="zope2.View" />

    <!-- content custom views -->
    <!-- Custom view for EmailContent -->
    <browser:page
        for="cedes.core.content.email.IEmailContent"
        class="cedes.core.browser.content.EmailContentView"
        name="view"
        template="templates/emailcontent_view.pt"
        permission="zope2.View" />
    <!-- Custom view for Point -->
    <browser:page
        for="cedes.core.content.dossierstructure.IPoint"
        class="cedes.core.browser.content.PointView"
        name="view"
        template="templates/point_view.pt"
        permission="zope2.View" />

    <!-- dossierstructure_pdf -->
    <browser:page
        for="*"
        class="cedes.core.browser.dossierstructure.DossierStructurePDF"
        name="dossierstructure_pdf"
        template="templates/dossierstructure_pdf.pt"
        permission="zope2.View" />
    <!-- generate_pdf -->
    <browser:view
        for="cedes.core.content.dossierstructure.IDossierStructure"
        class="cedes.core.browser.dossierstructure.GeneratePDFView"
        name="generate_pdf"
        permission="cmf.ManagePortal" />
    <!-- pdf -->
    <browser:view
        for="cedes.core.content.dossierstructure.IDossierStructure"
        class="cedes.core.browser.dossierstructure.GetPDFView"
        name="pdf"
        permission="zope2.View" />

    <!-- The view rendering html-toc -->
    <browser:view
        for="*"
        class="cedes.core.browser.dossierstructure.HTMLTocView"
        name="html-toc"
        allowed_attributes="point_title
                            point_number"
        permission="zope2.View" />

    <!-- The view rendering plan-classement -->
    <browser:page
        for="cedes.core.content.theme.ITheme"
        class="cedes.core.browser.views.PlanClassementView"
        name="plan-classement"
        template="templates/plan-classement.pt"
        permission="zope2.View" />

    <!-- portlets -->
    <browser:page
        for="*"
        class="cedes.core.browser.portlets.PortletRecent"
        name="portlet_recent"
        template="templates/portlet_recent.pt"
        permission="zope2.View" />
    <browser:page
        for="*"
        class="cedes.core.browser.portlets.PortletPlan"
        name="portlet_plan"
        template="templates/portlet_plan.pt"
        permission="zope2.View" />
    <browser:page
        for="*"
        class="cedes.core.browser.portlets.PortletDossiers"
        name="portlet_dossiers"
        template="templates/portlet_folders.pt"
        permission="zope2.View" />
    <browser:page
        for="*"
        class="cedes.core.browser.portlets.PortletCedes"
        name="portlet_cedes"
        template="templates/portlet_folders.pt"
        permission="zope2.View" />

    <!-- Asynchronous calls (ajax) -->
    <browser:page
        name="ds_price"
        class=".async.DSPrice"
        for="*"
        permission="zope2.View" />

    <!-- CeDES night tasks view -->
    <browser:page
        name="cedes-night-tasks"
        class=".views.CeDESNightTasks"
        for="plone.app.layout.navigation.interfaces.INavigationRoot"
        permission="cmf.ManagePortal" />

    <!-- Members management -->
    <!-- Views -->
    <!-- plone.app.users -->
    <browser:page
        name="member-search"
        for="*"
        class=".membersearch.CeDESMemberSearchForm"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="cmf.ListPortalMembers" />
    <browser:page
        name="register"
        for="plone.app.layout.navigation.interfaces.INavigationRoot"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        class=".register.CeDESRegistrationForm"
        permission="cmf.AddPortalMember" />
    <browser:page
        name="registered"
        for="plone.app.layout.navigation.interfaces.INavigationRoot"
        class=".registered.CeDESRegisteredView"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        template="templates/registered.pt"
        permission="cmf.AddPortalMember" />
  <browser:page
        name="personal-information"
        for="plone.app.layout.navigation.interfaces.INavigationRoot"
        class=".overrides.CeDESUserDataPanel"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="cmf.SetOwnProperties" />
    <!-- CeDES views -->
    <browser:page
        name="my-account"
        for="*"
        class=".member.MyAccountView"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        template="templates/member_my_account.pt"
        permission="zope2.View" />
    <browser:page
        name="member-account-details"
        for="*"
        class=".member.AccountDetailsView"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        template="templates/member_account_details.pt"
        permission="zope2.View" />
    <browser:page
        name="member-debug"
        for="*"
        class=".member.MemberDebugView"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        template="templates/member_debug.pt"
        permission="cmf.ManagePortal" />
    <browser:view
        for="*"
        class=".member.DownloadBillWaitingPayment"
        name="download-bill-waiting-payment"
        permission="zope2.View" />
    <!-- Forms -->
    <browser:page
        name="member-credit"
        for="*"
        class=".member.MemberCreditForm"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        permission="cmf.ManagePortal" />
    <browser:page
        name="member-renew"
        for="plone.app.layout.navigation.interfaces.INavigationRoot"
        class=".member.RenewAccountForm"
        permission="cmf.SetOwnProperties" />
    <browser:page
        name="member-switch100"
        for="plone.app.layout.navigation.interfaces.INavigationRoot"
        class=".member.Switch100Form"
        permission="cmf.SetOwnProperties" />
    <browser:page
        for="*"
        name="member-fix-failed-accounting"
        permission="cmf.ManagePortal"
        class=".member.FixFailedAccountingFormWrapper" />

    <!-- override display for RelatedItemsWidget -->
    <z3c:widgetTemplate
        mode="display"
        widget="plone.app.z3cform.interfaces.IRelatedItemsWidget"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        template="templates/relateditems_display.pt" />

</configure>
