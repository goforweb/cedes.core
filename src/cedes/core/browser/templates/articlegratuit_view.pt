<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"
      metal:use-macro="here/main_template/macros/master">
<body>

<metal:main fill-slot="content-core">
    <tal:main-macro metal:define-macro="content">

        <tal:block replace="structure python: view.render_cr_first_classification_date()" />
        <tal:block replace="structure python: view.render_references()" />
        <tal:block replace="structure python: view.render_description()" />
        <tal:block replace="structure python: view.render_file()" />
        <tal:block replace="structure python: view.render_html('cr_html_preview')" />
        <tal:block replace="structure python: view.render_common_content()" />

    </tal:main-macro>
</metal:main>

</body>
</html>