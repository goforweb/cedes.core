<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"
  metal:use-macro="here/main_template/macros/master">
  <body>

    <metal:main fill-slot="content-core">
      <tal:main-macro metal:define-macro="content"
                      tal:define="context_uid python: context.UID();
                                  mayView python: view.member.check_viewable(context_uid);
                                  warned python: context.REQUEST['HTTP_REFERER'].startswith(portal_url) and not 'credentials_cookie_auth' in context.REQUEST['HTTP_REFERER'];">

        <tal:block replace="structure python: view.render_cr_first_classification_date()" />

        <tal:block replace="structure python: view.render_references()" />

        <tal:block replace="structure python: view.render_description()" />

        <tal:notMayView condition="python: not mayView and not warned">
          <div class="portalMessage statusmessage statusmessage-warning alert alert-warning">
            <tal:icon tal:define="icons nocall: context/@@iconresolver"
                      tal:replace="structure python:icons.tag('plone-statusmessage-warning', tag_alt='', tag_class='statusmessage-icon mb-1 me-2')" />
            <strong>Avertissement</strong>
            <span>Vous êtes sur le point de consulter un article payant.
              Votre compte sera débité de 1 point.
              Cliquez sur <a href="#" tal:attributes="href string:${context/absolute_url}/view">"Continuer"</a> pour confirmer!
            </span>
          </div>
        </tal:notMayView>

        <tal:mayView condition="python: mayView or warned">
          <tal:free condition="python: view.member.is_cedes_free()">
            <div class="portalMessage statusmessage statusmessage-warning alert alert-warning">
              <tal:icon tal:define="icons nocall: context/@@iconresolver"
                        tal:replace="structure python:icons.tag('plone-statusmessage-warning', tag_alt='', tag_class='statusmessage-icon mb-1 me-2')" />
              <strong>Avertissement</strong>
              <span>Vous devez &ecirc;tre membre CeDES 100% pour pouvoir consulter les articles
              payants ou les s&eacute;quences d'apprentissage.
              Allez dans <a tal:attributes="href string:${portal_url}/@my-account">
              "Mon compte"</a> pour modifier votre abonnement.</span>
            </div>
          </tal:free>

          <div tal:omit-tag=""
               tal:condition="python:not view.member.is_cedes_free() and not(view.member.check_balance(1)) and not mayView">
            <div class="portalMessage statusmessage statusmessage-error alert alert-danger">
              <tal:icon tal:define="icons nocall: context/@@iconresolver"
                        tal:replace="structure python:icons.tag('plone-statusmessage-error', tag_alt='', tag_class='statusmessage-icon mb-1 me-2')" />
              <strong>Erreur</strong>
              <span>SOLDE INSUFFISANT</span>
            </div>
          </div>

          <div tal:omit-tag="" tal:condition="python:view.member.check_balance(1) or mayView">
            <span tal:omit-tag="" tal:define="dummy python:view.member.add_transaction(context_uid)"/>
            <tal:block replace="structure python: view.render_file()" />
            <tal:block replace="structure python: view.render_html('cr_html_preview')" />
            <tal:block replace="structure python: view.render_common_content()" />
          </div>

        </tal:mayView>

      </tal:main-macro>
    </metal:main>

  </body>
</html>