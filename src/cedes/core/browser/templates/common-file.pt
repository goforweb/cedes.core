<fieldset class="file" tal:define="has_file python: context.file and context.file.getSize()">
  <legend>Télécharger le document</legend>
  <div class="d-flex" tal:condition="has_file">
    <a class="download-file glyphicon glyphicon-cloud-download"
       target="_blank"
       tal:attributes="href string:${here/absolute_url}/@@download;
                       title here/pretty_title_or_id;">
    </a>
    <div class="px-2 text-muted" tal:content="python: view._render_file_infos()" />
  </div>
  <p tal:condition="python: not has_file" class="discreet">Aucun document à télécharger.</p>
</fieldset>