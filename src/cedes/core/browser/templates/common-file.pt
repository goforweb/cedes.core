<fieldset class="file">
  <legend>Télécharger le document</legend>
  <a class='visualNoPrint'
     tal:condition="python: context.file"
     target="_blank"
     tal:attributes="href string:${here/absolute_url}/@@download;
                     title here/pretty_title_or_id;">
      <img tal:attributes="src string:${view/portal_url}/++plone++cedes.core/pdf_icon.gif"
           alt="PDF" align="absmiddle"/>
  </a>
  <p tal:condition="python: not context.file" class="discreet">Aucun document à télécharger.</p>
</fieldset>