<fieldset tal:define="text python: getattr(context, view._html_fieldname)"
          tal:attributes="class python: view._html_fieldname">
  <legend tal:content="python: view.fields[view._html_fieldname].field.title">Field title</legend>
  <div tal:condition="python: text and text.raw.strip()" class="plain">
      <div tal:replace="structure python: text.output_relative_to(context)" />
  </div>
  <p tal:condition="python: text is None or not text.raw.strip()"
     class="discreet"
     tal:content="python: view._html_empty_text">
    Nothing to display.
  </p>
</fieldset>
