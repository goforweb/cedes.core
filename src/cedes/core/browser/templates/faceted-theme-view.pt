<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"
  xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:metal="http://xml.zope.org/namespaces/metal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n"
  metal:use-macro="context/main_template/macros/master"
  i18n:domain="eea">

<body>
  <metal:content-core fill-slot="content-core">
    <metal:block define-macro="content-core">
      <div style="clear: both">&nbsp;</div>
      <tal:defines define="layout nocall:context/@@faceted-theme-view;
                           is_search layout/is_search">

        <tal:faceted_search condition="python: is_search">
          <div tal:condition="layout/may_search" tal:define="dummy python: request.set('folderContents', folderContents);">
            <div metal:use-macro="here/search_macros/macros/search_header_macro" />
            <tal:results condition="folderContents">
              <tal:block define="common_result_listing_content context/@@common-result-listing-content/index;">
                <tal:content replace="structure common_result_listing_content" />
              </tal:block>
              <tal:content replace="structure python: ('<script>$(\'#common-result-content\').highlightSearchTerms({terms: %s});</script>' % layout.search_terms()).replace('u\'', '\'')" />
            </tal:results>
          </div>
          <div tal:condition="not:layout/may_search">
            <dl class="portalMessage warning">
              <dd>L'accès au moteur de recherche est réservé aux abonnés CeDES 100%. Il est gracieusement mis à la disposition des abonnés CeDES Free durant une semaine.
              Allez dans <a style="color:#555555;font-weight:bold;text-decoration:underline;" tal:attributes="href string:${layout/portal_url}/plone_memberprefs_panel">'Mon compte'</a> pour modifier votre abonnement.</dd>
            </dl>
          </div>
        </tal:faceted_search>

        <tal:no_faceted_search condition="not: is_search">
          <tal:defines define="is_root python: context.is_root()">
            <tal:theme condition="python: not context.is_root()">
              <theme_view metal:use-macro="context/theme_view/macros/content-core" />
            </tal:theme>
            <tal:pc condition="">
              <pc_view tal:replace="structure context/@@planclassement_view" />
            </tal:pc>
          </tal:defines>
        </tal:no_faceted_search>
      </tal:defines>
    </metal:block>
  </metal:content-core>
</body>
</html>
