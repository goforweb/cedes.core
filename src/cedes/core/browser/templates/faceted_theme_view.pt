<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"
  xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:metal="http://xml.zope.org/namespaces/metal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n"
  metal:use-macro="context/main_template/macros/master"
  i18n:domain="eea">

<body>
  <metal:content-core fill-slot="content-core">
    <metal:block define-macro="content-core">
      <div style="clear: both">&nbsp;</div>
      <tal:defines define="layout nocall:context/@@faceted-theme-view;
                           is_search layout/is_search;
                           portal_url python: layout.portal_url;
                           icons nocall: context/@@iconresolver">

        <tal:faceted_search condition="python: is_search">
          <div tal:condition="layout/may_search"
               tal:define="dummy python: request.set('folderContents', folderContents);
                           batch python: folderContents;
                           batch_length python: batch.sequence_length;">

            <div class="portalMessage statusmessage statusmessage-info alert alert-info"
                 tal:condition="python: batch_length <= 5">
              <tal:icon tal:replace="structure python:icons.tag('plone-statusmessage-info', tag_alt='', tag_class='statusmessage-icon mb-1 me-2')" />
              <strong>Info</strong>
              <span>Votre recherche n'affiche aucun ou trop peu de résultats?
                      <a href="#"
                         tal:attributes="href string:$portal_url/pages/aide#S9">Cliquez ici</a>
                      pour savoir comment en améliorer la pertinence.
              </span>
            </div>

            <div class="portalMessage statusmessage statusmessage-info alert alert-info"
                 tal:condition="python: batch_length >= 50">
              <tal:icon tal:replace="structure python:icons.tag('plone-statusmessage-info', tag_alt='', tag_class='statusmessage-icon mb-1 me-2')" />
              <strong>Info</strong>
              <span>Votre recherche affiche trop de résultats?
                <a href="#" tal:attributes="href string:$portal_url/pages/aide#S8">Cliquez ici</a> pour savoir comment en améliorer la pertinence.
              </span>
            </div>

            <div tal:condition="batch_length">
                <h3 class="search-results-number">
                    <span tal:omit-tag="" tal:content="batch_length">234</span> <span tal:replace="python:batch_length>1 and 'éléments correspondent à vos critères de recherche' or 'élément correspond à vos critères de recherche'"/>
                </h3>
            </div>
            <a class="reinit_faceted_search" href="#" onclick="event.preventDefault();resetFaceted();">Réintialiser la recherche</a>

            <tal:results condition="folderContents">
              <tal:block define="common_result_listing_content context/@@common-result-listing-content/index;">
                <tal:content replace="structure common_result_listing_content" />
              </tal:block>
              <tal:content replace="structure python: ('<script>$(\'#common-result-content\').highlightSearchTerms({terms: %s});</script>' % layout.search_terms())" />
            </tal:results>
          </div>

          <div tal:condition="not:layout/may_search">
            <div class="portalMessage statusmessage statusmessage-warning alert alert-warning">
              <tal:icon tal:replace="structure python:icons.tag('plone-statusmessage-warning', tag_alt='', tag_class='statusmessage-icon mb-1 me-2')" />
              <strong>Avertissement</strong>
              <span>L'accès au moteur de recherche est réservé aux abonnés CeDES 100%. Il est gracieusement mis à la disposition des abonnés CeDES Free durant une semaine.
              Allez dans <a tal:attributes="href string:${layout/portal_url}/@@my-account">"Mon compte"</a> pour modifier votre abonnement.
              </span>
            </div>
          </div>
        </tal:faceted_search>

        <tal:no_faceted_search condition="not: is_search">
          <tal:defines define="is_root python: context.is_root()">
            <tal:theme condition="python: not is_root">
              <theme_view metal:use-macro="context/@@view/macros/content-core" />
            </tal:theme>
            <tal:pc condition="python: is_root">
              <pc_view tal:replace="structure context/@@planclassement_view" />
            </tal:pc>
          </tal:defines>
        </tal:no_faceted_search>

      </tal:defines>
    </metal:block>
  </metal:content-core>
</body>
</html>
