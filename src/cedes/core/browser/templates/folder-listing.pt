<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
      lang="en"
      metal:use-macro="here/main_template/macros/master"
      i18n:domain="plone">
<body>

<metal:content-core fill-slot="content-core">
<metal:block define-macro="content-core">

        <a href=""
           class="link-parent"
           tal:define="parent_url python:here.aq_parent.absolute_url()"
           tal:condition="parent_url"
           tal:attributes="href parent_url"
           i18n:translate="go_to_parent_url">
        Aller au niveau supérieur
        </a>

        <tal:block define="common_result_listing context/@@common-result-listing/index;">
            <tal:content replace="structure common_result_listing" />
        </tal:block>

        <span tal:omit-tag=""
              tal:define="contentFilter python:{'portal_type':['Document', 'Link', 'Image', 'File', 'Event', 'News Item',], 'sort_on':'getObjPositionInParent'};
                          dummy python: context.REQUEST.set('contentFilter', contentFilter);">
          <div tal:define="plone_listing_view python: context.restrictedTraverse('@@plone_listing_view')"
               metal:use-macro="plone_listing_view/macros/listing" />
        </span>

        <div class="visualClear"><!-- --></div>

</metal:block>
</metal:content-core>

</body>
</html>
