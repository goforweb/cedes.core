<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
      lang="en"
      metal:use-macro="here/main_template/macros/master"
      i18n:domain="plone">

<metal:block fill-slot="top_slot"
             tal:define="dummy python:request.set('disable_border',1)" />

<body>

   <div metal:fill-slot="main">

    <h1 class="documentFirstHeading">
      <span tal:replace="python: view.member.Title()"/>
    </h1>

    <p class="lead">Paramètres de mon compte</p>

    <div class="portalMessage statusmessage statusmessage-warning alert alert-warning"
         tal:define="bill python: view.member.get_bill_waiting_payment()"
         tal:condition="python: bill and bill.get('pdf')">
      <tal:icon tal:define="icons nocall: context/@@iconresolver""
                tal:replace="structure python:icons.tag('plone-statusmessage-warning', tag_alt='', tag_class='statusmessage-icon mb-1 me-2')" />
      <strong>Attention</strong>
      <span>Il y a une facture en attente de paiement!
        <a target="_blank"
           tal:attributes="href python: view.download_bill_url()">
            <img tal:attributes="src string:${view/portal_url}/++plone++cedes.core/pdf_icon.gif" />
            &nbsp;Télécharger la facture au format PDF
        </a>
      <br />
      </span>
    </div>

    <p tal:condition="python: not view.member.is_cedes_free()">
        <b tal:condition="python: not view.member.get_bill_accounting_failed() and not view.member.get_bill_waiting_payment()">
          Votre compte "CeDES 100%" est activé.
        </b>

        <div class="portalMessage statusmessage statusmessage-warning alert alert-warning"
             tal:condition="python: view.member.get_bill_accounting_failed()">
          <tal:icon tal:define="icons nocall: context/@@iconresolver""
                    tal:replace="structure python:icons.tag('plone-statusmessage-warning', tag_alt='', tag_class='statusmessage-icon mb-1 me-2')" />
          <strong>Attention</strong>
          <span>
            Votre compte "CeDES 100%" est en cours d'activation, vous recevrez bientôt une facture par e-mail.
          </span>
        </div>

        <br />
        Le solde de votre compte est de <b tal:content="python: view.member.get_account_balance()"/> points.
        Vos points sont valides jusqu'au <b tal:content="python:view.plone_view.toLocalizedTime(view.expiration_date)"/>.
    </p>
    <p tal:condition="python: view.member.is_cedes_free()">
      <b>Vous disposez d'un compte "CeDES Free".</b>
    </p>

    <ul>
      <li>
         <a href="" tal:attributes="href string:${portal_url}/@@change-password">Définir un nouveau mot de passe</a>
      </li>
      <li>
         <a href="" tal:attributes="href string:${portal_url}/@@personal-information">Editer mes données personnelles</a>
      </li>
      <li tal:condition="python: not view.member.is_cedes_free()">
         <a href="" tal:attributes="href string:${portal_url}/@@member-account-details">Consulter le solde de mon compte et mes transactions</a>
      </li>
      <li tal:condition="python: not view.member.is_cedes_free()">
        <a href="" tal:attributes="href string:${portal_url}/@@member-renew"><b>Renouveler mon abonnement (30€ par an)</b>. La confirmation vous sera demandée dans l'écran suivant.</a>
      </li>
      <li tal:condition="python: view.member.is_cedes_free()">
        <a href="" tal:attributes="href string:${portal_url}/@@member-switch100"><b>Devenir membre CeDES 100% (30€ par an).</b> La confirmation vous sera demandée dans l'écran suivant.</a>
      </li>
    </ul>
    </div>

</body>
</html>
