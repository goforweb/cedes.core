<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="plone">
<body>


<metal:main fill-slot="main"
     tal:define="auth nocall:context/acl_users/credentials_cookie_auth|nothing">

    <h1 class="documentFirstHeading"
        i18n:translate="heading_welcome">
        Welcome!
    </h1>

    <span tal:condition="python:view.member_type == 'CeDES Free'"
          tal:content="structure here/pages/inscription-confirmation-cedesfree/getText"
          tal:on-error="string:inscription-confirmation-cedesfree"/>
    <span tal:condition="python:view.member_type == 'CeDES 100%'"
          tal:content="structure here/pages/inscription-confirmation-cedes100pc/getText"
          tal:on-error="string:inscription-confirmation-cedes100pc"/>

</metal:main>
</body>
</html>
