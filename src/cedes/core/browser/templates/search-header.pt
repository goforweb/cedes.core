<metal:search_header_macro define-macro="search_header_macro"
                           tal:define="results_length request/folderContents/sequence_length|string:0;
                                       portal_url context/@@plone_portal_state/portal_url">
    <dl tal:condition="request/dateerror | nothing" class="portalMessage error">
    <dt>Erreur</dt>
    <dd>La recherche n'a pas pris les dates en compte (vos dates comportaient une erreur)</dd>
    </dl>

    <dl tal:condition="request/keyworderror | nothing" class="portalMessage error">
    <dt>Erreur</dt>
    <dd>La recherche ne prend pas en compte les opérateurs booléens (AND, OR, NOT, *, ?)</dd>
    </dl>

    <dl tal:condition="python: not request.get('dateerror', None) and not request.get('keyworderror', None) and results_length <= 5" class="portalMessage info">
    <dt>Info</dt>
    <dd>Votre recherche n'affiche aucun ou trop peu de résultats? <a href="#" tal:attributes="href string:$portal_url/pages/aide#S9">Cliquez ici</a> pour savoir comment en améliorer la pertinence.</dd>
    </dl>

    <dl tal:condition="python: results_length >= 50"
        class="portalMessage info">
    <dt>Info</dt>
    <dd>Votre recherche affiche trop de résultats? <a href="#" tal:attributes="href string:$portal_url/pages/aide#S8">Cliquez ici</a> pour savoir comment en améliorer la pertinence.</dd>
    </dl>

    <a class="reinit_faceted_search" href="#" onclick="event.preventDefault();resetFaceted();">Réintialiser la recherche</a>

    <div tal:condition="results_length">
        <h2 class="search-results-number">
            <span tal:omit-tag="" tal:content="results_length">234</span> <span tal:replace="python:results_length>1 and 'éléments correspondent à vos critères de recherche' or 'élément correspond à vos critères de recherche'"/>
        </h2>
    </div>

</metal:search_header_macro>