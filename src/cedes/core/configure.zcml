<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:browser="http://namespaces.zope.org/browser"
           xmlns:i18n="http://namespaces.zope.org/i18n"
           xmlns:transmogrifier="http://namespaces.plone.org/transmogrifier"
           xmlns:zcml="http://namespaces.zope.org/zcml"
           xmlns:five="http://namespaces.zope.org/five">

    <i18n:registerTranslations directory="locales" />

    <!--include zcml:condition="installed collective.dexteritytextindexer"
                package="collective.dexteritytextindexer" /-->
    <include package="Products.CMFCore" file="permissions.zcml" />

    <!--include package="ftw.referencewidget" /-->
    <!-- include package="collective.z3cform.datagridfield" /-->
    <include package="iw.debug" />
    <include package="z3c.form" file="meta.zcml" />

    <include package=".browser" />
    <include package=".content" />
    <include package=".filters" />
    <include package=".gopress" />
    <include zcml:condition="installed plone.app.transmogrifier" package=".pipelines" />

    <include file="events.zcml" />
    <include file="profiles.zcml" />
    <include file="vocabularies.zcml" />

    <!-- Faceted criteria adapter -->
    <adapter for="cedes.core.interfaces.IThemeFacetedNavigable"
             provides="eea.facetednavigation.interfaces.ICriteria"
             factory="cedes.core.adapters.ThemeCriteria" />

    <!-- portal_catalog indexes -->
    <adapter name="all_associated_theme_uids"
             factory=".indexes.all_associated_theme_uids" />
    <adapter name="associated_themes_title_and_path"
             factory=".indexes.associated_themes_title_and_path" />
    <adapter name="associated_theme_uids"
             factory=".indexes.associated_theme_uids" />
    <adapter name="title_path"
             factory=".indexes.title_path" />
    <adapter name="colophon_with_author"
             factory=".indexes.colophon_with_author" />
    <adapter name="has_cr_points"
             factory=".indexes.has_cr_points" />
    <adapter name="cr_date_index"
             factory=".indexes.cr_date_index" />
    <adapter name="cr_first_classification_date_index"
             factory=".indexes.cr_first_classification_date_index" />
    <adapter name="user_ratings"
             factory=".indexes.user_ratings" />

    <!-- collective.dexteritytextindexer RichText converter -->
    <adapter
        zcml:condition="installed plone.app.textfield"
        factory="cedes.core.indexes.ResourceRichTextIndexFieldConverter" />

    <!-- collective.dexteritytextindexer extender -->
    <adapter factory="cedes.core.indexes.ResourceSearchableTextExtender"
             name="ResourceSearchableTextExtender" />

    <!-- CedesMemberData -->
    <adapter
      provides="Products.CMFCore.interfaces.IMember"
      factory="cedes.core.memberdata.CedesMemberData" />

    <!-- Theme, set exclude_from_nav=True by default -->
    <adapter
        for="cedes.core.content.theme.ITheme"
        factory="plone.app.dexterity.behaviors.exclfromnav.default_exclude_true" />

    <class class="cedes.core.content.theme.Theme">
        <implements interface="eea.facetednavigation.interfaces.IPossibleFacetedNavigable" />
    </class>

</configure>
