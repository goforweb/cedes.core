<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:five="http://namespaces.zope.org/five"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="cedes.core">


    <!-- SchemaPolicy -->
    <utility
        factory="cedes.core.content.articlegratuit.ArticleGratuitSchemaPolicy"
        name="schema_policy_articlegratuit" />
    <utility
        factory="cedes.core.content.articlepayant.ArticlePayantSchemaPolicy"
        name="schema_policy_articlepayant" />
    <utility
        factory="cedes.core.content.audio.AudioSchemaPolicy"
        name="schema_policy_audio" />
    <utility
        factory="cedes.core.content.bibliographie.BibliographieSchemaPolicy"
        name="schema_policy_bibliographie" />
    <utility
        factory="cedes.core.content.dossierstructure.DossierStructureSchemaPolicy"
        name="schema_policy_dossierstructure" />
    <utility
        factory="cedes.core.content.dossierstructure.PointSchemaPolicy"
        name="schema_policy_point" />
    <utility
        factory="cedes.core.content.sequenceapprentissage.SequenceApprentissageSchemaPolicy"
        name="schema_policy_sequenceapprentissage" />
    <utility
        factory="cedes.core.content.siteinternet.SiteInternetSchemaPolicy"
        name="schema_policy_siteinternet" />
    <utility
        factory="cedes.core.content.statistiques.StatistiquesSchemaPolicy"
        name="schema_policy_statistiques" />
    <utility
        factory="cedes.core.content.theme.ThemeSchemaPolicy"
        name="schema_policy_theme" />
    <utility
        factory="cedes.core.content.video.VideoSchemaPolicy"
        name="schema_policy_video" />

</configure>
