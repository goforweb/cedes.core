<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:browser="http://namespaces.zope.org/browser"
           xmlns:five="http://namespaces.zope.org/five"
           xmlns:plone="http://namespaces.plone.org/plone">

    <browser:view
        for="*"
        name="gopress"
        class=".views.GoPressView"
        permission="zope2.ViewManagementScreens"
        allowed_attributes="synchronize" />

    <browser:view
        for="*"
        name="xml-to-plone"
        class=".views.XmlToPloneView"
        permission="zope2.ViewManagementScreens"
        allowed_attributes="getFoldersInformation
                            getArticlesInformation
			    upload_article
                            merge_and_upload_articles" />

    <browser:view
        for="*"
        name="download-article-pdf"
        class=".views.DownloadArticlePDFView"
        permission="zope2.ViewManagementScreens" />

    <!-- Form for gopress import -->
    <browser:page
        for="*"
        layer="cedes.core.interfaces.ICedesCoreLayer"
        name="gopress_import"
        class=".forms.GopressImportFormWrapper"
        permission="zope2.ViewManagementScreens" />

</configure>
