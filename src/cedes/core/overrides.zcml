<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:browser="http://namespaces.zope.org/browser"
           xmlns:plone="http://namespaces.plone.org/plone"
           xmlns:zcml="http://namespaces.zope.org/zcml"
           i18n_domain="cedes.core">

    <!-- CedesMemberData -->
    <configure package="Products.PlonePAS">
        <adapter
            provides="Products.CMFCore.interfaces.IMember"
            factory="cedes.core.memberdata.CedesMemberData" />
    </configure>

    <!-- disable the @@z3cform_validate_field -->
    <browser:page
        name="z3cform_validate_field"
        for="*"
        class="cedes.core.browser.overrides.CeDESInlineValidationView"
        permission="zope.Public" />

    <!-- portlet -->
    <configure package="plone.app.portlets.portlets">
        <plone:portlet
            name="portlets.Navigation"
            interface=".navigation.INavigationPortlet"
            assignment=".navigation.Assignment"
            renderer="cedes.core.browser.portlets.CedesNavigationRenderer"
            addview=".navigation.AddForm"
            editview=".navigation.EditForm" />
    </configure>
    <configure package="plone.app.portlets.portlets">
        <plone:portlet
            name="portlets.Recent"
            interface=".recent.IRecentPortlet"
            assignment=".recent.Assignment"
            renderer="cedes.core.browser.portlets.CedesRecentRenderer"
            addview=".recent.AddForm"
            editview=".recent.EditForm" />
    </configure>

    <!-- Override principals/users/groups vocabularies to add caching -->
    <utility factory=".vocabularies.CeDESUsersFactory"
             name="plone.app.vocabularies.Users" />
    <utility factory=".vocabularies.CeDESGroupsFactory"
             name="plone.app.vocabularies.Groups" />
    <utility factory=".vocabularies.CeDESPrincipalsFactory"
             name="plone.app.vocabularies.Principals" />

</configure>
