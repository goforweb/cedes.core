<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:browser="http://namespaces.zope.org/browser"
           xmlns:i18n="http://namespaces.zope.org/i18n"
           xmlns:transmogrifier="http://namespaces.plone.org/transmogrifier"
           xmlns:zcml="http://namespaces.zope.org/zcml"
           xmlns:five="http://namespaces.zope.org/five">

    <!-- data -->
    <transmogrifier:registerConfig
      name="collective.jsonmigrator.data"
      title="CeDES: migrate common data (Folder, Document, Image)"
      configuration="data.cfg" />

    <!-- carousel -->
    <transmogrifier:registerConfig
      name="collective.jsonmigrator.carousel"
      title="CeDES: migrate carousel"
      configuration="carousel.cfg" />

    <!-- members -->
    <transmogrifier:registerConfig
      name="collective.jsonmigrator.members"
      title="CeDES: migrate members"
      configuration="members.cfg" />

    <!-- resources -->
    <transmogrifier:registerConfig
      name="collective.jsonmigrator.resources"
      title="CeDES: migrate common resources (ArticleGratuit, ArticlaPayant, SiteInternet, ...)"
      configuration="resources.cfg" />

    <!-- themes -->
    <transmogrifier:registerConfig
      name="collective.jsonmigrator.themes"
      title="CeDES: migrate common themes (Theme)"
      configuration="themes.cfg" />

  <utility component=".blueprints.Yays"
      name="cedes.core.blueprints.yays" />

  <utility component=".blueprints.SkipIfExists"
      name="cedes.core.blueprints.skipifexists" />

  <utility component=".blueprints.SkipIfNoRelatedItems"
      name="cedes.core.blueprints.skipifnorelateditems" />

</configure>
