<?xml version="1.0"?>
<object name="portal_workflow" meta_type="Plone Workflow Tool">

 <property
    name="title">Contains workflow definitions for your portal</property>
 <object name="two_states_open_workflow" meta_type="Workflow"/>
 <object name="two_states_private_workflow" meta_type="Workflow"/>

 <bindings>

  <!-- default, two_states_private_workflow -->
  <default>
   <bound-workflow workflow_id="two_states_private_workflow"/>
  </default>

  <!-- two_states_open_workflow -->
  <type type_id="Document">
     <bound-workflow workflow_id="two_states_open_workflow"/>
  </type>
  <type type_id="Event">
     <bound-workflow workflow_id="two_states_open_workflow"/>
  </type>
  <type type_id="Folder">
     <bound-workflow workflow_id="two_states_private_workflow"/>
  </type>
  <type type_id="ftw.slider.Container">
     <bound-workflow workflow_id="two_states_open_workflow"/>
  </type>
  <type type_id="ftw.slider.Pane">
     <bound-workflow workflow_id="two_states_open_workflow"/>
  </type>

  <!-- one_state_workflow -->
  <type type_id="Image">
     <bound-workflow workflow_id="one_state_workflow"/>
  </type>
  <type type_id="File">
     <bound-workflow workflow_id="one_state_workflow"/>
  </type>
 </bindings>

</object>
